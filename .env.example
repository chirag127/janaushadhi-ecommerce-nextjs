# ==========================================================================
# Jan Aushadhi Ecommerce (Next.js) — Environment Variables
# --------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in values.
# ==========================================================================

# Neon catalog+commerce DB (project sweet-silence-15535482)
# Get via: neon connection-string --project-id sweet-silence-15535482
DATABASE_URL=postgresql://neondb_owner:<password>@<host>-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<password>@<host>.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Managed Better Auth — oriz-accounts hub (project autumn-recipe-04450972)
# Enable "Managed Better Auth" in the Neon Console for that project; the base URL
# is shown on the Auth tab (looks like https://ep-xxx.neonauth.us-east-2.aws.neon.tech).
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech

# Cookie signing secret — min 32 chars. Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=change-me-at-least-32-characters-long

# Optional: share auth cookies across *.oriz.in subdomains for SSO
# NEON_AUTH_COOKIE_DOMAIN=.oriz.in

# Public site origin — used for SEO metadata, sitemap, and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay test mode. "true" keeps Checkout in test mode; set "false" for live.
NEXT_PUBLIC_RAZORPAY_TEST_MODE=true
